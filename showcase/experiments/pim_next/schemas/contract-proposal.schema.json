{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIM NEXT Contract Proposal v1",
  "description": "Shape only. Runtime additionally enforces exact UTF-8 byte limits, strict finite declarations, semantic change and recomputed hashes. No approval or activation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "original_problem_utf8", "parent_contract_utf8", "proposed_contract_utf8", "original_problem_sha256", "parent_sha256", "proposed_sha256", "case_id", "parent_version", "proposed_version", "reason", "evidence_refs", "proposal_sha256"],
  "properties": {
    "schema_version": {"type": "string", "const": "pim-next.contract-proposal.v1"},
    "status": {"type": "string", "const": "PROPOSED"},
    "original_problem_utf8": {"type": "string", "minLength": 1, "maxLength": 65536},
    "parent_contract_utf8": {"type": "string", "minLength": 1, "maxLength": 131072},
    "proposed_contract_utf8": {"type": "string", "minLength": 1, "maxLength": 131072},
    "original_problem_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposed_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "parent_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "proposed_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"},
    "reason": {"type": "string", "minLength": 1, "maxLength": 4096},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
